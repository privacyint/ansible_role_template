---
profile: production

exclude_paths:
  - .*/
  - molecule/**/roles/

skip_list: []

warn_list:
  - experimental
  - no-handler

kinds:
  - requirements: "requirements.yml"
  - requirements: "**/molecule/*/requirements.yml"
  - molecule: "**/molecule/*/molecule.yml"
  - playbook: "*.yml"
  - playbook: "*.yaml"
  - playbook: "**/molecule/*/*.yml"
  - tasks: "**/tasks/*.yml"
  - vars: "**/vars/*.yml"
  - meta: "**/meta/*.yml"
  - yaml: ".ansible-lint"

offline: false
