---
extends: default

ignore: |
  .git/
  .ansible/
  .venv/
  .molecule/
  .pytest_cache/
  molecule/*/roles/

rules:
  line-length:
    max: 160
    level: warning
  indentation:
    spaces: 2
    indent-sequences: true
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']
  comments-indentation: false
  document-start: enable
  empty-lines:
    max: 2
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
